<?php
/**
 * @var \Panth\ClaudeAi\Block\Adminhtml\Checkpoint $block
 * @var \Magento\Framework\Escaper $escaper
 */
$rows = $block->getCheckpoints(200);
?>
<div class="claudeai-page">
    <div class="admin__page-section">
        <div class="admin__page-section-title">
            <span class="title"><?= $escaper->escapeHtml(__('Checkpoints & restore')) ?></span>
        </div>
        <div class="admin__page-section-content">
            <p class="claudeai-help">
                <?= $escaper->escapeHtml(__('Every bulk change the AI made created an undo point. Click Restore on any row to roll it back. Older un-restored checkpoints auto-prune based on retention config.')) ?>
            </p>

            <?php if (empty($rows)): ?>
                <div class="claudeai-empty">
                    <p><strong><?= $escaper->escapeHtml(__('No checkpoints yet.')) ?></strong></p>
                    <p class="claudeai-help"><?= $escaper->escapeHtml(__('Bulk writes the AI performs (price changes, stock updates, status flips) appear here automatically for one-click rollback.')) ?></p>
                </div>
            <?php else: ?>
                <table class="data-grid">
                    <thead>
                        <tr>
                            <th class="data-grid-th"><?= $escaper->escapeHtml(__('When')) ?></th>
                            <th class="data-grid-th"><?= $escaper->escapeHtml(__('Operation')) ?></th>
                            <th class="data-grid-th"><?= $escaper->escapeHtml(__('Description')) ?></th>
                            <th class="data-grid-th" style="text-align:right"><?= $escaper->escapeHtml(__('Records')) ?></th>
                            <th class="data-grid-th"><?= $escaper->escapeHtml(__('Status')) ?></th>
                            <th class="data-grid-th" style="text-align:right;width:140px"><?= $escaper->escapeHtml(__('Action')) ?></th>
                        </tr>
                    </thead>
                    <tbody>
                        <?php foreach ($rows as $cp): ?>
                            <tr>
                                <td style="white-space:nowrap"><?= $escaper->escapeHtml(date('M j H:i:s', strtotime((string) $cp->getData('created_at')))) ?></td>
                                <td><code style="font-size:12px"><?= $escaper->escapeHtml((string) $cp->getData('op_type')) ?></code></td>
                                <td style="max-width:380px"><?= $escaper->escapeHtml((string) $cp->getData('description')) ?></td>
                                <td style="text-align:right"><strong><?= (int) $cp->getData('record_count') ?></strong></td>
                                <td>
                                    <?php $st = (string) $cp->getData('status'); ?>
                                    <?php if ($st === 'restored'): ?>
                                        <span class="claudeai-status-pill" style="background:#dbe9fe;color:#1f4480"><?= $escaper->escapeHtml(__('Restored')) ?></span>
                                    <?php elseif ($st === 'expired'): ?>
                                        <span class="claudeai-status-pill" style="background:#e8e8e8;color:#555"><?= $escaper->escapeHtml(__('Expired')) ?></span>
                                    <?php else: ?>
                                        <span class="claudeai-status-pill claudeai-status-ok"><?= $escaper->escapeHtml(__('Active')) ?></span>
                                    <?php endif; ?>
                                </td>
                                <td style="text-align:right">
                                    <?php if ($st === 'active'): ?>
                                        <button type="button" class="claudeai-post-action"
                                                style="color:#1979c3;background:none;border:0;padding:0;cursor:pointer"
                                                data-mage-init='<?= $escaper->escapeHtmlAttr(json_encode(['Panth_ClaudeAi/js/post-action' => ['url' => $block->getRestoreUrl((string) $cp->getData('checkpoint_id')), 'title' => (string) __('Restore checkpoint'), 'message' => (string) __('Restore this checkpoint? This will revert %1 records.', (int) $cp->getData('record_count'))]])) ?>'>↶ <?= $escaper->escapeHtml(__('Restore')) ?></button>
                                    <?php else: ?>
                                        <span style="color:#aaa">-</span>
                                    <?php endif; ?>
                                </td>
                            </tr>
                        <?php endforeach; ?>
                    </tbody>
                </table>
            <?php endif; ?>
        </div>
    </div>

</div>
